{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(evals/**)",
      "Edit(docs/**)",
      "Edit(package.json)",
      "Edit(.github/**)",
      "Edit(.githooks/**)",
      "Edit(.factory/**)",
      "Edit(.claude/**)",
      "Edit(feature_list.json)",
      "Edit(CODEOWNERS)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/factory/hooks/path-guard.sh compliance",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/factory/hooks/secret-guard.sh --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/factory/hooks/session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/factory/hooks/stop-report.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
