{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(tests/**)", "Edit(evals/**)", "Edit(src/contracts/**)", "Edit(src/templates/**)", "Edit(src/security/**)", "Edit(docs/**)", "Edit(package.json)", "Edit(pnpm-lock.yaml)",
      "Edit(.github/**)",
      "Edit(.githooks/**)",
      "Edit(.factory/**)",
      "Edit(.claude/**)",
      "Edit(feature_list.json)",
      "Edit(CODEOWNERS)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "/workspace/factory/hooks/path-guard.sh builder", "timeout": 15 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "/workspace/factory/hooks/secret-guard.sh --hook", "timeout": 15 }]
      }
    ]
  }
}
