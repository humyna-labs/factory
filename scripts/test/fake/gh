#!/usr/bin/env bash
# Fake gh for offline tests of the human-run scripts. State lives in $FAKE_GH_DIR:
#   log (one line per call), repo.json, workflow.json, rulesets.json, labels.json, prs.json,
#   membership.json (absent = 404), fail (regex: a call whose argv matches it exits 1),
#   corrupt (present = the ruleset reads back with enforcement "evaluate"), remote (bare repo path).
set -u
d=${FAKE_GH_DIR:?}
printf '%s\n' "$*" >>"$d/log"
if [ -f "$d/fail" ] && printf '%s' "$*" | grep -Eq -- "$(cat "$d/fail")"; then echo "fake gh: failing on purpose" >&2; exit 1; fi
args=()
while [ $# -gt 0 ]; do
  case "$1" in --hostname) shift 2 ;; *) args+=("$1"); shift ;; esac
done
set -- "${args[@]}"
jqx() { # <json> <jq expr or empty>
  if [ -n "$2" ]; then printf '%s' "$1" | jq -r "$2"; else printf '%s\n' "$1"; fi
}
opt() { # <name> <args...>: value after option
  n=$1; shift
  while [ $# -gt 0 ]; do [ "$1" = "$n" ] && { printf '%s' "${2:-}"; return 0; }; shift; done
  return 1
}
jq_expr=$(opt --jq "$@" || true)
case "$1 ${2:-}" in
  "auth status") exit 0 ;;
  "repo clone") git clone -q "$(cat "$d/remote")" "$4"; exit $? ;;
  "label create") jq --arg n "$3" '. + [$n] | unique' "$d/labels.json" >"$d/t" && mv "$d/t" "$d/labels.json"; exit 0 ;;
  "label list") jqx "$(jq '[.[] | {name: .}]' "$d/labels.json")" "$jq_expr"; exit 0 ;;
  "pr list") jqx "$(cat "$d/prs.json")" "$jq_expr"; exit 0 ;;
  "pr create") exit 0 ;;
  "pr view") jqx '{"url":"https://github.com/humyna-labs/x/pull/1"}' "$jq_expr"; exit 0 ;;
  api*) ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 2 ;;
esac
shift
method=$(opt -X "$@" || echo GET)
path=""
fields="{}"
while [ $# -gt 0 ]; do
  case "$1" in
    -X | --jq | --input) shift 2 ;;
    --silent) shift ;;
    -F | -f) k=${2%%=*}; v=${2#*=}
      if [ "$1" = -F ] && { [ "$v" = true ] || [ "$v" = false ]; }; then fields=$(printf '%s' "$fields" | jq --arg k "$k" --argjson v "$v" '.[$k] = $v')
      else fields=$(printf '%s' "$fields" | jq --arg k "$k" --arg v "$v" '.[$k] = $v'); fi
      shift 2 ;;
    *) path=$1; shift ;;
  esac
done
case "$method $path" in
  "GET repos/"*/*/actions/permissions/workflow) jqx "$(cat "$d/workflow.json")" "$jq_expr" ;;
  "PUT repos/"*/*/actions/permissions/workflow) jq --argjson f "$fields" '. + $f' "$d/workflow.json" >"$d/t" && mv "$d/t" "$d/workflow.json" ;;
  "GET repos/"*/*/rulesets) jqx "$(jq '[.[] | {id, name}]' "$d/rulesets.json")" "$jq_expr" ;;
  "POST repos/"*/*/rulesets) body=$(cat); jq --argjson b "$body" '. + [($b + {id: 7})]' "$d/rulesets.json" >"$d/t" && mv "$d/t" "$d/rulesets.json" ;;
  "PUT repos/"*/*/rulesets/*) id=${path##*/}; body=$(cat); jq --argjson b "$body" --argjson id "$id" 'map(if .id == $id then ($b + {id: $id}) else . end)' "$d/rulesets.json" >"$d/t" && mv "$d/t" "$d/rulesets.json" ;;
  "GET repos/"*/*/rulesets/*) id=${path##*/}; r=$(jq --argjson id "$id" '.[] | select(.id == $id)' "$d/rulesets.json")
    [ -f "$d/corrupt" ] && r=$(printf '%s' "$r" | jq '.enforcement = "evaluate"')
    jqx "$r" "$jq_expr" ;;
  "GET repos/"*/*) jqx "$(cat "$d/repo.json")" "$jq_expr" ;;
  "PATCH repos/"*/*) jq --argjson f "$fields" '. + $f' "$d/repo.json" >"$d/t" && mv "$d/t" "$d/repo.json" ;;
  "GET orgs/"*/teams/*) jqx '{"id":42}' "$jq_expr" ;;
  "GET orgs/"*/memberships/*) [ -f "$d/membership.json" ] || { echo "HTTP 404" >&2; exit 1; }; jqx "$(cat "$d/membership.json")" "$jq_expr" ;;
  *) echo "fake gh: unsupported api $method $path" >&2; exit 2 ;;
esac
